      "item": [
        {
          "name": "Login (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\r\n    const body = pm.response.json();\r\n    pm.collectionVariables.set('token', body.token);\r\n    pm.test('token received', () => pm.expect(body.token).to.be.a('string'));\r\n} else {\r\n    pm.test('login failed', () => pm.expect.fail('Status ' + pm.response.code));\r\n}"
                ]
              }
            }
